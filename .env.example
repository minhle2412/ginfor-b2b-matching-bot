# =====================================================================
# B2B MATCHING — CẤU HÌNH MẪU
# Copy file này thành .env ở thư mục gốc dự án rồi điền giá trị thật.
#   cp .env.example .env
# TUYỆT ĐỐI KHÔNG commit file .env lên git.
# =====================================================================

# ---------------------------------------------------------------------
# 1. NGUỒN DỮ LIỆU DOANH NGHIỆP SUPPLIER
# ---------------------------------------------------------------------
# supabase = dữ liệu chính thức (mặc định khi đã có URL + KEY)
# csv      = dữ liệu mẫu Business_dataset.csv (dùng để chạy offline)
SUPPLIER_SOURCE=supabase

# Lấy tại: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...............

# Tên bảng chứa danh sách doanh nghiệp supplier
SUPABASE_SUPPLIER_TABLE=suppliers

# (Tuỳ chọn) Schema khác 'public'
# SUPABASE_SCHEMA=public

# (Tuỳ chọn) Lọc PostgREST khi tải dữ liệu, nhiều điều kiện nối bằng &
# Ví dụ: chỉ lấy DN Việt Nam đang hoạt động
# SUPABASE_SUPPLIER_FILTER=country=eq.Vietnam&status=eq.active

# Số dòng mỗi lần gọi API (mặc định 1000 — giới hạn của PostgREST)
SUPABASE_PAGE_SIZE=1000

# Đường dẫn CSV khi SUPPLIER_SOURCE=csv
# SUPPLIER_CSV_PATH=Business_dataset.csv

# ---------------------------------------------------------------------
# 2. MAPPING CỘT (TUỲ CHỌN)
# ---------------------------------------------------------------------
# Bỏ trống toàn bộ phần này thì hệ thống TỰ DÒ tên cột (bỏ dấu, bỏ gạch dưới,
# không phân biệt hoa thường). Chỉ điền khi tự dò sai.
#
# Chạy lệnh sau để xem schema thật + mapping đã dò được:
#     python -m datasource.introspect
#     python -m datasource.introspect --list-tables
#
# SUPPLIER_COL_ID=id
# SUPPLIER_COL_NAME=ten_cong_ty
# SUPPLIER_COL_MST=mst
# SUPPLIER_COL_EMAIL=email
# SUPPLIER_COL_PHONE=sdt
# SUPPLIER_COL_MAIN_INDUSTRY=nganh_chinh
# SUPPLIER_COL_SUB_INDUSTRY=nganh_phu
# SUPPLIER_COL_ADDRESS=dia_chi
# SUPPLIER_COL_CITY=tinh_thanh
# SUPPLIER_COL_TYPE=loai_hinh
# SUPPLIER_COL_DESCRIPTION=mo_ta
# SUPPLIER_COL_INDUSTRY_GROUP=nhom_nganh
# SUPPLIER_COL_CLASSIFICATION=nhom_phan_loai
# SUPPLIER_COL_WEBSITE=website

# ---------------------------------------------------------------------
# 3. TRỌNG SỐ MATCHING
# ---------------------------------------------------------------------
MATCH_W_SEMANTIC=0.50
MATCH_W_LEXICAL=0.30
MATCH_W_LOCATION=0.20
MATCH_MIN_SCORE=0.30
MATCH_TOP_N=5

# ---------------------------------------------------------------------
# 4. BOT FACEBOOK / DISCORD (nhánh comment vào bài viết)
# ---------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
OUTREACH_REVIEW_CHANNEL_ID=

FB_COOKIE_C_USER=
FB_COOKIE_XS=
FB_GROUP_IDS=

SIMILARITY_THRESHOLD=0.55
SCRAPE_HOUR=8
SCRAPE_MINUTE=0
SCRAPE_DAYS_LIMIT=7
SCRAPE_PAGES_LIMIT=3

# ---------------------------------------------------------------------
# 5. DỊCH BÀI ĐĂNG BUYER (Anh → Việt)
# ---------------------------------------------------------------------
# Bài đăng trên các trang B2B e-commerce viết bằng tiếng Anh, còn mô tả doanh
# nghiệp trong Supabase là tiếng Việt và model SBERT là model đơn ngữ tiếng Việt.
# Không dịch thì điểm ngữ nghĩa gần như vô nghĩa.
# Bài đăng Facebook group đã là tiếng Việt nên được tự động bỏ qua.
TRANSLATE_BUYER_POSTS=true

# nmt      = model dịch offline qua transformers (mặc định, miễn phí, không cần key)
# glossary = chỉ thay thế thuật ngữ theo từ điển B2B (tức thì, không cần model)
TRANSLATION_BACKEND=nmt

# Model NMT. Mặc định ~300MB, tải 1 lần vào ~/.cache/huggingface
# Yêu cầu: pip install sentencepiece sacremoses
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-vi
TRANSLATION_BATCH_SIZE=8

# Cache bản dịch (mỗi đoạn chỉ dịch 1 lần, kể cả khi chạy lại pipeline)
# TRANSLATION_CACHE_DB=.cache/translations.db

# ---------------------------------------------------------------------
# 6. B2B HARVESTER (nhánh email marketing)
# ---------------------------------------------------------------------
# B2B_HARVESTER_DB=b2b_harvester/b2b_harvester.db
# B2B_MAX_PAGES=3
# B2B_PROXY_SERVER=

# Cấu hình gửi email marketing (Resend/SendGrid) sẽ bổ sung khi triển khai
# bước outreach — hiện kết quả matching chỉ được xếp vào hàng đợi.
